# Default extraction provider: gemini | anthropic | openai_compat
LLM_PROVIDER=gemini
# Which providers are compared with each other (--provider both)
LLM_AGREE_PROVIDERS=gemini,anthropic

# Gemini, Google's own API
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# Claude (needs pip install -e ".[anthropic]"). Empty values mean the official
# API and the SDK's default key. For the AnyModel proxy:
#   CLAUDE_BASE_URL=https://anymodel.org/v1   CLAUDE_MODEL=claude-sonnet-5
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=claude-haiku-5-5

# Any OpenAI-compatible /chat/completions. For AnyModel:
#   OPENAI_COMPAT_BASE_URL=https://anymodel.org/v1   OPENAI_COMPAT_MODEL=ag/gemini-3-flash
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
