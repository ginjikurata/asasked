# Провайдер извлечения по умолчанию: gemini | anthropic | openai_compat
LLM_PROVIDER=gemini
# Какие провайдеры сверяются друг с другом (--provider both)
LLM_AGREE_PROVIDERS=gemini,anthropic

# Gemini, родной API Google
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# Claude (нужен pip install -e ".[anthropic]"). Пустые значения — официальный
# API и стандартный ключ SDK. Для прокси AnyModel:
#   CLAUDE_BASE_URL=https://anymodel.org/v1   CLAUDE_MODEL=claude-sonnet-5
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=claude-haiku-5-5

# Любой OpenAI-совместимый /chat/completions. Для AnyModel:
#   OPENAI_COMPAT_BASE_URL=https://anymodel.org/v1   OPENAI_COMPAT_MODEL=ag/gemini-3-flash
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
